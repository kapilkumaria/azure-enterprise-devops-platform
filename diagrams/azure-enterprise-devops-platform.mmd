%%{
  init: {
    "theme": "base",
    "flowchart": {
      "curve": "basis",
      "nodeSpacing": 45,
      "rankSpacing": 65,
      "htmlLabels": true
    }
  }
}%%

flowchart LR

    %% =========================================================
    %% SOURCE
    %% =========================================================

    DEV["Developer / Git"]
    AGENT["AWS EC2 Self-hosted Agent"]

    %% =========================================================
    %% AZURE DEVOPS
    %% =========================================================

    subgraph ADO["Azure DevOps"]
        direction LR

        CI["CI Pipeline"]
        CD["CD Pipeline"]

        CI -->|"Signed immutable artifact"| CD
    end

    %% =========================================================
    %% TERRAFORM
    %% =========================================================

    subgraph TF["Terraform IaC"]
        direction LR

        STATE["Remote State"]
        MODULES["Reusable Modules"]

        STATE --> MODULES
    end

    %% =========================================================
    %% MICROSOFT AZURE
    %% =========================================================

    subgraph AZURE["Microsoft Azure"]
        direction LR

        ACR["Azure Container Registry"]

        subgraph AKS["Azure Kubernetes Service"]
            direction TB

            NODES["System + User Node Pools"]

            subgraph ENV["Application Environments"]
                direction LR
                DEVNS["Dev"]
                STGNS["Staging"]
                PRODNS["Production"]
            end

            WORKLOAD["Deployments / Services / HPA"]

            NODES --> ENV
            ENV --> WORKLOAD
        end

        subgraph IDSEC["Identity & Secrets"]
            direction LR

            WI["Entra Workload Identity"]
            KV["Azure Key Vault"]

            WI -->|"RBAC"| KV
        end

        subgraph OBS["Observability"]
            direction LR

            MON["Container Insights"]
            LAW["Log Analytics"]
            ALERT["Alerts / Action Group"]

            MON --> LAW
            LAW --> ALERT
        end
    end

    %% =========================================================
    %% DELIVERY FLOW
    %% =========================================================

    DEV -->|"Source change"| CI

    AGENT -.->|"Runs"| CI
    AGENT -.->|"Runs"| CD

    CI -->|"Push image"| ACR

    ACR -->|"Image digest"| AKS

    CD -->|"Deploy"| AKS

    %% =========================================================
    %% IDENTITY / SECRETS
    %% =========================================================

    AKS -->|"OIDC"| WI
    KV -->|"CSI secret"| AKS

    %% =========================================================
    %% OBSERVABILITY
    %% =========================================================

    AKS -.->|"Telemetry"| MON

    %% =========================================================
    %% TERRAFORM PROVISIONING
    %% =========================================================

    MODULES -.->|"Provision"| AZURE

    %% =========================================================
    %% STYLING
    %% =========================================================

    classDef external fill:#f6f8fa,stroke:#57606a,stroke-width:1.5px,color:#24292f;
    classDef pipeline fill:#eaf2ff,stroke:#0969da,stroke-width:2px,color:#24292f;
    classDef azure fill:#eef6ff,stroke:#0078d4,stroke-width:1.5px,color:#24292f;
    classDef security fill:#f5f0ff,stroke:#8250df,stroke-width:1.5px,color:#24292f;
    classDef observability fill:#effaf3,stroke:#1a7f37,stroke-width:1.5px,color:#24292f;
    classDef terraform fill:#f7f0ff,stroke:#844fba,stroke-width:1.5px,color:#24292f;

    class DEV,AGENT external;
    class CI,CD pipeline;
    class ACR,NODES,DEVNS,STGNS,PRODNS,WORKLOAD azure;
    class WI,KV security;
    class MON,LAW,ALERT observability;
    class STATE,MODULES terraform;
