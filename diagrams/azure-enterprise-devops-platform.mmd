flowchart TB

    %% =========================================================
    %% DEVELOPER / SOURCE
    %% =========================================================

    DEV["👨‍💻 Developer"]
    REPO["Git Repository<br/>Application + Terraform + Kubernetes + Pipelines"]

    DEV -->|Commit / Pull Request| REPO


    %% =========================================================
    %% AZURE DEVOPS
    %% =========================================================

    subgraph ADO["Azure DevOps"]
        CI["CI Pipeline"]
        CD["CD Pipeline"]

        VALIDATE["Python / Application Validation"]
        TRIVYFS["Trivy Filesystem Scan"]
        BUILD["Docker Build"]
        TRIVYIMG["Trivy Image Scan"]
        REPORTS["JSON / SARIF<br/>Security Artifacts"]

        DEVSTAGE["Dev Deployment"]
        STAGESTAGE["Staging Deployment"]
        APPROVAL["Production Approval"]
        PRODSTAGE["Production Deployment"]

        CI --> VALIDATE
        VALIDATE --> TRIVYFS
        TRIVYFS --> BUILD
        BUILD --> TRIVYIMG
        TRIVYIMG --> REPORTS

        CD --> DEVSTAGE
        DEVSTAGE --> STAGESTAGE
        STAGESTAGE --> APPROVAL
        APPROVAL --> PRODSTAGE
    end

    REPO --> CI


    %% =========================================================
    %% SELF-HOSTED PIPELINE AGENT
    %% =========================================================

    subgraph AWS["AWS"]
        AGENT["EC2 Self-Hosted<br/>Azure DevOps Agent<br/><br/>Terraform<br/>Azure CLI<br/>Docker<br/>kubectl<br/>Trivy"]
    end

    CI -.Pipeline Jobs.-> AGENT
    CD -.Pipeline Jobs.-> AGENT


    %% =========================================================
    %% TERRAFORM
    %% =========================================================

    subgraph TF["Terraform Infrastructure as Code"]

        BOOTSTRAP["Bootstrap<br/>Remote State Backend"]

        MODULES["Reusable Modules<br/><br/>networking<br/>aks<br/>acr<br/>identity<br/>key-vault<br/>monitoring"]

        ENV["Environment Composition<br/>terraform/environments/dev"]

        BOOTSTRAP --> ENV
        MODULES --> ENV
    end

    REPO --> TF
    AGENT -->|terraform plan / apply| ENV


    %% =========================================================
    %% AZURE
    %% =========================================================

    subgraph AZURE["Microsoft Azure"]

        subgraph RG["Resource Group — rg-aedp-dev-cac"]

            %% NETWORK

            subgraph VNET["Virtual Network"]
                AKSSUBNET["AKS Subnet"]
                PESUBNET["Private Endpoint Subnet"]
            end


            %% REGISTRY

            ACR["Azure Container Registry<br/>ACR"]


            %% IDENTITY

            subgraph IDENTITY["Microsoft Entra / Managed Identity"]
                CONTROLID["AKS Control Plane<br/>Managed Identity"]
                WORKLOADID["Application Workload<br/>Managed Identity"]
                OIDC["AKS OIDC Issuer"]
                FICDEV["Federated Credential<br/>Dev"]
                FICSTG["Federated Credential<br/>Staging"]
                FICPROD["Federated Credential<br/>Prod"]
            end


            %% KEY VAULT

            KV["Azure Key Vault"]


            %% AKS

            subgraph AKS["Azure Kubernetes Service"]

                SYSPOOL["System Node Pool"]
                USERPOOL["User Node Pool"]

                subgraph K8S["Kubernetes Workloads"]

                    subgraph DEVNS["Dev Namespace"]
                        DEVAPP["Application"]
                        DEVSA["ServiceAccount"]
                        DEVHPA["HPA"]
                    end

                    subgraph STGNS["Staging Namespace"]
                        STGAPP["Application"]
                        STGSA["ServiceAccount"]
                        STGHPA["HPA"]
                    end

                    subgraph PRODENV["Production Namespace"]
                        PRODAPP["Application"]
                        PRODSA["ServiceAccount"]
                        PRODHPA["HPA"]
                    end

                    CSI["Secrets Store CSI Driver"]
                end

                SYSPOOL --> K8S
                USERPOOL --> DEVAPP
                USERPOOL --> STGAPP
                USERPOOL --> PRODAPP
            end


            %% OBSERVABILITY

            subgraph OBS["Azure-Native Observability"]
                DCR["Data Collection Rule"]
                LAW["Log Analytics Workspace"]
                INSIGHTS["Container Insights"]
                ALERT["Azure Monitor<br/>Scheduled Query Alert"]
                ACTION["Action Group"]

                DCR --> LAW
                INSIGHTS --> LAW
                LAW --> ALERT
                ALERT --> ACTION
            end
        end
    end


    %% =========================================================
    %% DELIVERY FLOW
    %% =========================================================

    TRIVYIMG -->|Approved Image| ACR

    ACR -->|AcrPull via Azure RBAC| AKS

    DEVSTAGE -->|kubectl / Kustomize| DEVAPP
    STAGESTAGE -->|kubectl / Kustomize| STGAPP
    PRODSTAGE -->|kubectl / Kustomize| PRODAPP


    %% =========================================================
    %% NETWORK / AKS
    %% =========================================================

    AKSSUBNET --> AKS
    CONTROLID --> AKSSUBNET


    %% =========================================================
    %% WORKLOAD IDENTITY
    %% =========================================================

    DEVSA --> OIDC
    STGSA --> OIDC
    PRODSA --> OIDC

    OIDC --> FICDEV
    OIDC --> FICSTG
    OIDC --> FICPROD

    FICDEV --> WORKLOADID
    FICSTG --> WORKLOADID
    FICPROD --> WORKLOADID

    WORKLOADID -->|Key Vault Secrets User| KV

    KV --> CSI
    CSI --> DEVAPP
    CSI --> STGAPP
    CSI --> PRODAPP


    %% =========================================================
    %% MONITORING
    %% =========================================================

    AKS --> DCR
    AKS --> INSIGHTS
    AKS --> LAW


    %% =========================================================
    %% TERRAFORM PROVISIONING
    %% =========================================================

    ENV -.Provision / Configure.-> VNET
    ENV -.Provision / Configure.-> AKS
    ENV -.Provision / Configure.-> ACR
    ENV -.Provision / Configure.-> KV
    ENV -.Provision / Configure.-> IDENTITY
    ENV -.Provision / Configure.-> OBS
